[Unit]
Description=Zolory A3 Chip Discord Bot - Revolutionary AI Voice Bot
Documentation=https://github.com/zap/zolory-discord-bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zolory-discord-bot
Environment=NODE_ENV=production
Environment=PATH=/usr/bin:/usr/local/bin
ExecStart=/usr/bin/node bot.js
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=30
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zolory-bot

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/ubuntu/zolory-discord-bot/logs
ReadWritePaths=/tmp

# Resource limits
LimitNOFILE=65535
MemoryAccounting=true
MemoryMax=2G
CPUAccounting=true

[Install]
WantedBy=multi-user.target